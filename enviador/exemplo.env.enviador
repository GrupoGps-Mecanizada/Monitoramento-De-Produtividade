# Copie este arquivo para ".env.enviador" (nesta mesma pasta) e preencha. Ele fica só no seu PC (fora do Git).

# Chave do WhatsApp (Evolution): a mesma do AUTHENTICATION_API_KEY do .env do Mensagens-Automaticas
EVOLUTION_CHAVE=

# Para quem mandar: um número (55 + DDD + número, só dígitos, ex.: 5531988887777)
# ou um grupo (o código termina em @g.us; para achar, rode "Listar grupos do WhatsApp.bat")
WHATSAPP_DESTINO=

# Só mude se for diferente
EVOLUTION_URL=http://localhost:8080
EVOLUTION_INSTANCIA=alertas-frota
